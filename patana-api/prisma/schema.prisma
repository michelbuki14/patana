generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["catalog", "booking", "checkout", "public"]
}

// ──────────────────────────────────────────────
// Public schema — auth & identity
// ──────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  password  String?
  role      String   @default("USER") // USER | OWNER | ADMIN
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("public")
}

// ──────────────────────────────────────────────
// Catalog schema — owners, properties, units
// ──────────────────────────────────────────────

model Owner {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  properties Property[]

  @@schema("catalog")
}

model Property {
  id             String   @id @default(uuid())
  title          String
  description    String?
  propertyType   String   // HOTEL | APARTMENT | VILLA
  address        String
  city           String
  country        String
  ownerId        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  owner   Owner  @relation(fields: [ownerId], references: [id])
  units     Unit[]

  @@schema("catalog")
}

model Unit {
  id          String   @id @default(uuid())
  propertyId  String
  title       String
  description String?
  capacity    Int
  basePrice   Float
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  property   Property @relation(fields: [propertyId], references: [id])
  availabilities Availability[]
  bookings   Booking[]

  @@schema("catalog")
}

// ──────────────────────────────────────────────
// Booking schema — availability & reservations
// ──────────────────────────────────────────────

model Availability {
  id            String   @id @default(uuid())
  unitId        String
  date          DateTime
  priceOverride Float?
  isAvailable   Boolean  @default(true)

  unit Unit @relation(fields: [unitId], references: [id])

  @@unique([unitId, date])
  @@schema("booking")
}

model Booking {
  id         String   @id @default(uuid())
  unitId     String
  userId     String
  checkIn    DateTime
  checkOut   DateTime
  guests     Int
  currency   String   @default("CDF")
  totalPrice Float
  status     String   @default("PENDING") // PENDING | CONFIRMED | CANCELLED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  unit   Unit   @relation(fields: [unitId], references: [id])
  payments Payment[]

  @@schema("booking")
}

// ──────────────────────────────────────────────
// Checkout schema — payments & transactions
// ──────────────────────────────────────────────

model Payment {
  id             String   @id @default(uuid())
  bookingId      String
  amount         Float
  currency       String   @default("CDF")
  method         String?  // MOBILE_MONEY | CARD | BANK
  idempotencyKey String   @unique
  status         String   @default("PENDING") // PENDING | SUCCEEDED | FAILED
  providerRef    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id])

  @@schema("checkout")
}
